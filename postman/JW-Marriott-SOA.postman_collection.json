    {
      "name": "4. Reservas (orquestador)",
      "item": [
        {
          "name": "Crear reserva integrada (habitación + tour + pago)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reservas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "description": "Ejemplo del Entregable 2 (sección 3.3). La primera vez crea la reserva; reintentar con la misma Idempotency-Key devuelve la misma respuesta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"{{cliente_id}}\",\n  \"habitacion_id\": \"HAB-301\",\n  \"desde\": \"2026-11-01\",\n  \"hasta\": \"2026-11-04\",\n  \"tour_id\": \"TOU-012\",\n  \"paquete_id\": null,\n  \"pago\": {\n    \"metodo\": \"TARJETA\",\n    \"token_tarjeta\": \"tok_abc123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clave nueva en cada corrida; el reintento siguiente reutiliza esta misma.",
                  "pm.collectionVariables.set(\"idem_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"reserva_id\", r.reserva_id);",
                  "pm.test(\"CONFIRMADA\", () => pm.expect(r.estado).to.eql(\"CONFIRMADA\"));",
                  "pm.test(\"Total 3140\", () => pm.expect(r.total).to.eql(3140));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reintento con la misma Idempotency-Key → misma reserva",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idem_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/reservas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"{{cliente_id}}\",\n  \"habitacion_id\": \"HAB-301\",\n  \"desde\": \"2026-11-01\",\n  \"hasta\": \"2026-11-04\",\n  \"tour_id\": \"TOU-012\",\n  \"paquete_id\": null,\n  \"pago\": {\n    \"metodo\": \"TARJETA\",\n    \"token_tarjeta\": \"tok_abc123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Mismo id\", () => pm.expect(pm.response.json().reserva_id).to.eql(pm.collectionVariables.get(\"reserva_id\")));",
